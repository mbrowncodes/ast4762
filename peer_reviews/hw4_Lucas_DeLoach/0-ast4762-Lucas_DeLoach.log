# Custom shortcut to mount and push the AST_4762C shared drive
gitpushdrive() {
    # 1. Navigate to the main repo directory
    cd ~/AST4762C_temp_work_area/AST_4762C/ || { echo "Directory not found!"; return 1; }

    # 2. Safely check if already mounted; if not, mount it (for reboots)
    if ! mountpoint -q ./shared_windows_linux_drive; then
        echo "Mounting shared drive..."
        sudo mount --bind /run/media/lucas-deloach/1DE213EC4C56818B/ ./shared_windows_linux_drive
    else
        echo "Drive already mounted."
    fi

    # 3. Stage the files
    git add shared_windows_linux_drive/

    # 4. Prompt for a commit message
    echo -n "Enter commit message (or press Enter for 'Auto-update'): "
    read -r msg
    if [ -z "$msg" ]; then
        msg="Auto-update shared drive $(date '+%Y-%m-%d %H:%M')"
    fi

    # 5. Commit and push
    git commit -m "$msg"
    git push origin main
}

